<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>COME FLY WITH ME — Christiansted mission map</name>
    <description>Normalized repository transcription of owner-supplied KMZ revision Come Fly With Me Spook Game 1 campaign pre-finale (5).kmz; source SHA-256 a717c4f2a93ac540fbc7e99025ab612ad33531ff426847e63ffb0130de2fb873. Thirteen point placemarks; no route lines or polygons. Wording has been normalized to correct directional, guard-accounting, contractor-framing, aircraft-designation, landing-coordinate, and typographical issues approved for repository landing.</description>
    <Style id="icon-1750-0288D1-normal">
      <IconStyle><scale>1</scale><Icon><href>images/icon-2.png</href></Icon></IconStyle>
      <LabelStyle><scale>0</scale></LabelStyle>
    </Style>
